<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>EduPortal - Login</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="login-page">
  <div class="login-box">
    <h2>EduPortal</h2>
    <p class="sub">Student Login</p>

    <% if (error) { %>
      <p class="error"><%= error %></p>
    <% } %>

    <form method="POST" action="/login" autocomplete="off">
      <label>Student ID</label>
      <input type="text" name="studentId" required>

      <label>Password</label>
      <input type="password" name="password" required>

      <label>Verification Code</label>
      <div class="captcha-row">
        <img id="captchaImg" src="/captcha" alt="captcha">
        <button type="button" id="refreshCaptcha">↻</button>
      </div>
      <input type="text" name="captcha" placeholder="Code bilkul waisa likhein jaisa dikh raha hai" required>

      <button type="submit" class="btn">Login</button>
    </form>
  </div>
  <script src="/js/login.js"></script>
</body>
</html>